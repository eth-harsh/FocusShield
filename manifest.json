{
  "manifest_version": 3,
  "name": "FocusShield",
  "version": "1.0.0",
  "description": "Stay focused while working...",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "action": {
    "default_title": "FocusShield",
    "default_popup": "popup.html"
  }
}
